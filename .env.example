# Clone AI environment variables
# Copy this file to `.env` in your clone home or export them in the shell.
# Values here are names and examples only — never paste live API keys into git.

# Where journal, config, memory, and isolated workspaces live (default: ~/.clone)
# CLONE_HOME=
# CLONE_AI_DATA_DIR=

# Project the workers run against (default: current working directory)
# CLONE_AI_WORKSPACE=

# Main Agent model in the Pi catalog, e.g. anthropic/claude-sonnet-4-5
# CLONE_AI_MAIN_MODEL=

# Opt-in paid planner (omit to keep the local deterministic planner)
# CLONE_AI_PLANNER=openai
# OPENAI_API_KEY=
# CLONE_AI_PLANNER_MODEL=gpt-5

# Journal backend (sqlite is the default; jsonl is the inspectable file)
# CLONE_AI_JOURNAL=sqlite

# Companion listen port (default 4317)
# CLONE_AI_PORT=4317

# Opt-in memory mining by a background agent (costs one model call per completed task)
# CLONE_AI_MEMORY_MINING=1

# Live tests only — do not set these for normal use
# CLONE_AI_MAIN_LIVE=1
# CLONE_AI_PI_LIVE=1
